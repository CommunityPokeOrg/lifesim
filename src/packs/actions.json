{
  "id": "actions",
  "name": "Actions & Careers",
  "version": "1.0.0",
  "description": "Player actions: jobs, shop items, gambling, and per-year life choices.",
  "events": [
    {
      "id": "debt_collector",
      "title": "Debt collectors",
      "description": "Some very persistent men in cheap suits want their money. Now.",
      "category": "money",
      "conditions": {
        "kind": "all",
        "conditions": [
          { "kind": "money", "op": "lt", "value": -3000 },
          { "kind": "not", "condition": { "kind": "flag", "flag": "in_prison", "equals": true } }
        ]
      },
      "weight": 30,
      "cooldown": 2,
      "repeatDecay": 0.9,
      "choices": [
        {
          "id": "beg",
          "text": "Beg for more time",
          "outcomes": [
            {
              "weight": 45,
              "effects": [
                { "kind": "stat", "stat": "happiness", "delta": -5 },
                { "kind": "counter", "flag": "debt_warnings", "delta": 1 }
              ],
              "result": "They reluctantly give you another year. The interest keeps ticking."
            },
            {
              "weight": 55,
              "effects": [
                { "kind": "stat", "stat": "health", "delta": -12 },
                { "kind": "stat", "stat": "happiness", "delta": -10 },
                { "kind": "counter", "flag": "debt_warnings", "delta": 2 }
              ],
              "result": "They make an example of you. You limp home."
            }
          ]
        },
        {
          "id": "smooth_talk",
          "text": "Talk your way out",
          "outcomes": [
            {
              "weight": 30,
              "weightModifiers": [
                { "when": { "kind": "trait", "trait": "charming" }, "add": 40 }
              ],
              "effects": [{ "kind": "stat", "stat": "happiness", "delta": 3 }],
              "result": "Somehow you charm them into leaving. For now."
            },
            {
              "weight": 70,
              "effects": [
                { "kind": "stat", "stat": "health", "delta": -8 },
                { "kind": "counter", "flag": "debt_warnings", "delta": 1 }
              ],
              "result": "They weren't buying it. A warning shot across the ribs."
            }
          ]
        }
      ]
    },
    {
      "id": "gambling_problem",
      "title": "The itch",
      "description": "You keep checking the odds. Friends are starting to worry about you.",
      "category": "casino",
      "conditions": {
        "kind": "all",
        "conditions": [
          { "kind": "counter", "flag": "gambling_count", "op": "gte", "value": 8 },
          { "kind": "not", "condition": { "kind": "flag", "flag": "in_prison", "equals": true } }
        ]
      },
      "weight": 35,
      "cooldown": 3,
      "repeatDecay": 0.8,
      "weightModifiers": [
        { "when": { "kind": "trait", "trait": "compulsive" }, "multiply": 1.6 }
      ],
      "choices": [
        {
          "id": "get_help",
          "text": "Get help ($1,000)",
          "conditions": { "kind": "money", "op": "gte", "value": 1000 },
          "effects": [
            { "kind": "money", "delta": -1000 },
            { "kind": "flag", "flag": "gambling_count", "value": 0 },
            { "kind": "trait", "trait": "compulsive", "action": "remove" },
            { "kind": "stat", "stat": "happiness", "delta": 8 }
          ],
          "result": "Therapy works. The itch fades to a memory."
        },
        {
          "id": "keep_playing",
          "text": "You can quit anytime",
          "effects": [
            { "kind": "stat", "stat": "happiness", "delta": -6 },
            { "kind": "counter", "flag": "gambling_count", "delta": 3 },
            { "kind": "trait", "trait": "compulsive", "action": "add" }
          ],
          "result": "Just one more bet. That's what you tell yourself."
        }
      ]
    },
    {
      "id": "house_warming",
      "title": "House warming",
      "description": "Your own place finally feels like home. Time to show it off?",
      "category": "life",
      "conditions": { "kind": "flag", "flag": "item_house", "equals": true },
      "weight": 8,
      "cooldown": 4,
      "repeatDecay": 0.5,
      "choices": [
        {
          "id": "party",
          "text": "Throw a party ($500)",
          "conditions": { "kind": "money", "op": "gte", "value": 500 },
          "effects": [
            { "kind": "money", "delta": -500 },
            { "kind": "stat", "stat": "happiness", "delta": 9 }
          ],
          "result": "A legendary night. The neighbors both envy and hate you."
        },
        {
          "id": "quiet",
          "text": "Enjoy a quiet evening in",
          "effects": [
            { "kind": "stat", "stat": "happiness", "delta": 4 },
            { "kind": "stat", "stat": "health", "delta": 1 }
          ],
          "result": "Home sweet home."
        }
      ]
    },
    {
      "id": "car_trouble",
      "title": "Car trouble",
      "description": "Your car coughs, shudders, and dies at a red light.",
      "category": "life",
      "conditions": { "kind": "flag", "flag": "item_used_car", "equals": true },
      "weight": 5,
      "cooldown": 4,
      "repeatDecay": 0.7,
      "choices": [
        {
          "id": "repair",
          "text": "Pay for repairs ($800)",
          "conditions": { "kind": "money", "op": "gte", "value": 800 },
          "effects": [
            { "kind": "money", "delta": -800 },
            { "kind": "stat", "stat": "happiness", "delta": -2 }
          ],
          "result": "Fixed. The mechanic even found your old sunglasses."
        },
        {
          "id": "sell_parts",
          "text": "Sell it for parts (+$1,200)",
          "effects": [
            { "kind": "money", "delta": 1200 },
            { "kind": "loseitem", "item": "used_car" },
            { "kind": "stat", "stat": "happiness", "delta": -4 }
          ],
          "result": "You watch it get towed away. Back to walking."
        }
      ]
    }
  ],
