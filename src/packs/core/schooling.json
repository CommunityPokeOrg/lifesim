              "weight": 70,
              "effects": [
                {
                  "kind": "stat",
                  "stat": "health",
                  "delta": -8
                },
                {
                  "kind": "stat",
                  "stat": "happiness",
                  "delta": -5
                }
              ],
              "result": "You got beaten up and spent recess in the nurse's office."
