        {
          "id": "tell_teacher",
          "text": "Tell a teacher",
          "effects": [
            {
              "kind": "stat",
              "stat": "happiness",
              "delta": 2
            }
          ],
          "result": "The teacher intervened. The bully got detention and a respect for authority he'll lose by Friday."
        }
