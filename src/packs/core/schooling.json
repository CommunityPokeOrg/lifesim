    {
      "id": "school_bully",
      "title": "School bully",
      "description": "A bigger kid blocks the water fountain. He knows about the lunch money. He has a plan.",
      "category": "school",
      "conditions": {
        "kind": "all",
        "conditions": [
          {
            "kind": "age",
            "min": 6,
            "max": 17
