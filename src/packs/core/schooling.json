      "weight": 100,
      "choices": [
        {
          "id": "go",
          "text": "Walk in like you own the place",
          "effects": [
            {
              "kind": "flag",
              "flag": "in_school",
              "value": true
            },
            {
              "kind": "stat",
              "stat": "happiness",
              "delta": 3
            }
          ],
          "result": "You enrolled. Recess ruled immediately."
        },
