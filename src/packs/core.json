          "result": "You got accepted! Student debt acquired: $20,000. The loans send their regards."
        },
        {
          "id": "work",
          "text": "Start working",
          "effects": [
            { "kind": "unflag", "flag": "in_school" },
            { "kind": "flag", "flag": "seeking_work", "value": true }
          ],
          "result": "No cap and gown debt for you. The workforce gets a fresh recruit."
        },
        {
          "id": "drift",
          "text": "Take a gap year",
          "effects": [
            { "kind": "unflag", "flag": "in_school" },
            { "kind": "flag", "flag": "seeking_work", "value": true },
            { "kind": "stat", "stat": "happiness", "delta": 8 }
          ],
          "result": "You drifted happily. The couch remembers you fondly."
        }
      ],
      "ui": { "x": 780, "y": 0 }
    },
    {
