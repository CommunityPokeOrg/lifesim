          "effects": [
            { "kind": "stat", "stat": "happiness", "delta": 5 },
            { "kind": "stat", "stat": "smarts", "delta": -2 }
          ],
          "result": "A great evening. Tomorrow-you will hate tonight-you."
        },
        {
          "id": "steal_notes",
          "text": "Permanently borrow the smart kid's notes",
          "outcomes": [
            {
              "weight": 60,
              "effects": [
