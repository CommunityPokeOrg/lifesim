  "description": "Starter pack: school, jobs, relationships, and crime.",
  "events": [
    {
      "id": "start_school",
      "title": "First day of school",
      "description": "Elementary school awaits. You have strong opinions about this for someone in dinosaur pajamas.",
      "category": "school",
      "once": true,
      "forced": true,
      "conditions": { "kind": "age", "min": 5, "max": 6 },
      "weight": 100,
      "choices": [
        {
          "id": "go",
          "text": "Walk in like you own the place",
          "effects": [
            { "kind": "flag", "flag": "in_school", "value": true },
            { "kind": "stat", "stat": "happiness", "delta": 3 }
          ],
          "result": "You enrolled. Recess ruled immediately."
        },
        {
          "id": "fake_sick",
          "text": "Fake a catastrophic tummy ache",
          "outcomes": [
            {
              "weight": 30,
              "weightModifiers": [
                { "when": { "kind": "trait", "trait": "charming" }, "add": 20 }
              ],
              "effects": [
                { "kind": "stat", "stat": "happiness", "delta": 5 },
                { "kind": "flag", "flag": "homeschooled", "value": true },
                { "kind": "flag", "flag": "seeking_work", "value": true }
              ],
              "result": "Sold it. You watched cartoons while the other kids learned shapes."
            },
            {
              "weight": 70,
              "effects": [
                { "kind": "flag", "flag": "in_school", "value": true },
                { "kind": "stat", "stat": "happiness", "delta": -4 }
              ],
              "result": "The thermometer betrayed you. You were carried in mid-fake-fever."
            }
          ]
        },
        {
          "id": "cling",
          "text": "Latch onto your mom's leg and scream",
          "outcomes": [
            {
              "weight": 15,
              "effects": [
                { "kind": "stat", "stat": "happiness", "delta": 4 },
                { "kind": "stat", "stat": "smarts", "delta": -2 },
                { "kind": "flag", "flag": "homeschooled", "value": true },
                { "kind": "flag", "flag": "seeking_work", "value": true }
              ],
              "result": "Your parents caved. Your curriculum is now 'whatever's on TV'."
            },
            {
              "weight": 85,
              "effects": [
                { "kind": "flag", "flag": "in_school", "value": true },
                { "kind": "stat", "stat": "happiness", "delta": -5 }
              ],
              "result": "They peeled you off like a barnacle. A Mrs. Grubb is now your nemesis."
            }
          ]
        }
      ],
      "ui": { "x": 0, "y": 0 }
    },
    {
      "id": "school_bully",
      "title": "School bully",
      "description": "A bigger kid blocks the water fountain. He knows about the lunch money. He has a plan.",
      "category": "school",
      "conditions": {
        "kind": "all",
        "conditions": [
          { "kind": "age", "min": 6, "max": 17 },
          { "kind": "flag", "flag": "in_school", "equals": true }
        ]
      },
      "weight": 10,
      "cooldown": 2,
      "repeatDecay": 0.6,
      "weightModifiers": [
        { "when": { "kind": "trait", "trait": "sickly" }, "multiply": 1.6 },
        { "when": { "kind": "trait", "trait": "athletic" }, "multiply": 0.5 }
      ],
      "choices": [
        {
          "id": "hand_over",
          "text": "Hand over the money",
          "effects": [{ "kind": "stat", "stat": "happiness", "delta": -6 }],
          "result": "He leaves with your sandwich money and a piece of your dignity."
        },
        {
          "id": "fight_back",
          "text": "Fight back",
          "outcomes": [
            {
              "weight": 30,
              "weightModifiers": [
                { "when": { "kind": "trait", "trait": "athletic" }, "add": 40 },
                { "when": { "kind": "stat", "stat": "health", "op": "gte", "value": 70 }, "add": 20 }
              ],
              "effects": [
                { "kind": "stat", "stat": "happiness", "delta": 8 },
                { "kind": "flag", "flag": "stood_up_to_bully", "value": true }
              ],
              "result": "You won. He respects you now, in the way bullies respect people who hit them."
            },
            {
              "weight": 70,
              "effects": [
                { "kind": "stat", "stat": "health", "delta": -8 },
                { "kind": "stat", "stat": "happiness", "delta": -5 }
              ],
              "result": "You got beaten up and spent recess in the nurse's office."
            }
          ]
        },
        {
          "id": "tell_teacher",
          "text": "Tell a teacher",
          "effects": [{ "kind": "stat", "stat": "happiness", "delta": 2 }],
          "result": "The teacher intervened. The bully got detention and a respect for authority he'll lose by Friday."
        }
      ],
      "ui": { "x": 260, "y": 0 }
    },
    {
