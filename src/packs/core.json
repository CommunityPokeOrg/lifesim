    {
      "id": "graduation",
      "title": "Graduation",
      "description": "Pomp, circumstance, and an itchy polyester gown. Adulthood awaits, and it charges rent.",
      "category": "school",
      "once": true,
      "forced": true,
      "conditions": {
        "kind": "all",
        "conditions": [
          { "kind": "age", "min": 17, "max": 19 },
          { "kind": "flag", "flag": "in_school", "equals": true }
